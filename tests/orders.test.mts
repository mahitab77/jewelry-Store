// Exercise retained direct-sales behavior; quotation-only denial has its own suites.
process.env.COMMERCE_MODE = "DIRECT_SALES";
import assert from 'node:assert/strict';
import { afterEach,beforeEach,test } from 'node:test';
import { randomUUID } from 'node:crypto';
import { orderFixture,fixtureOrder } from './helpers/order-fixture.mts';
import { ordersHttp } from '../src/lib/admin/orders/http.ts';
import { developmentId } from '../db/tools/seed.ts';
import type { AdminOrder } from '../src/lib/admin/orders/types.ts';
let f:Awaited<ReturnType<typeof orderFixture>>,headers:Headers;
beforeEach(async()=>{f=await orderFixture();headers=await f.headers();},{timeout:60000});
afterEach(async()=>{if(f)await f.close();});
async function request(path:string,body?:unknown,h=headers,extra:Record<string,string>={}){const requestHeaders=new Headers(h);requestHeaders.set('Origin',f.authConfig.baseURL);requestHeaders.set('Content-Type','application/json');for(const[k,v]of Object.entries(extra))requestHeaders.set(k,v);
  const r=await ordersHttp(new Request(f.authConfig.baseURL+'/api/admin/orders/'+path,{method:body===undefined?'GET':'POST',headers:requestHeaders,...(body===undefined?{}:{body:JSON.stringify(body)})}),[path],f.runtime);return {status:r.status,headers:r.headers,body:await r.json()};}
async function read(id:string){const r=await request(id);assert.equal(r.status,200);return r.body.order as AdminOrder;}
async function operation(id:string,action:string,extra:Record<string,unknown>={}){const o=await read(id);return request(id,{action,revision:o.revision,operationId:randomUUID(),...extra});}
const schedule=()=>({start:new Date(Date.now()+86400000).toISOString(),end:new Date(Date.now()+90000000).toISOString()});
const attempt=()=>new Date().toISOString();
async function arranged(method='PRIVATE_DELIVERY'){
  const a=await fixtureOrder(f,method);assert.equal((await operation(a.id,'prepare')).status,200);assert.equal((await operation(a.id,'contact')).status,200);
  assert.equal((await operation(a.id,'propose',schedule())).status,200);assert.equal((await operation(a.id,'confirm',{confirmed:true,assignedAdminId:f.users.ADMIN.id})).status,200);return a;
}
async function progressed(method='PRIVATE_DELIVERY'){const a=await arranged(method);assert.equal((await operation(a.id,method==='PRIVATE_DELIVERY'?'dispatch':'ready')).status,200);return a;}
async function handover(id:string){return operation(id,'complete',{confirmed:true,recipient:'Synthetic recipient',occurredAt:attempt(),notes:'Fixture handover observation'});}
async function financial(id:string){return {o:(await f.data.query('SELECT payment_status,total_minor,inventory_finalized_at,reconciliation_required,reconciliation_reason FROM orders WHERE id=$1',[id])).rows,p:(await f.data.query('SELECT id,status,amount_minor,refunded_minor,provider_transaction_reference FROM payments WHERE order_id=$1',[id])).rows,i:(await f.data.query('SELECT variant_id,on_hand,reserved FROM inventory ORDER BY variant_id')).rows,r:(await f.data.query('SELECT id,status,quantity FROM inventory_reservations WHERE order_id=$1 ORDER BY id',[id])).rows};}

test('unauthenticated reads and mutations are rejected before order access',async()=>{assert.equal((await request(randomUUID(),undefined,new Headers())).status,401);assert.equal((await request(randomUUID(),{},new Headers())).status,401);assert.equal((await request('search',{},new Headers())).status,401);});
test('disabled administrators lose access despite an existing valid session',async()=>{await f.data.query('UPDATE admin_users SET is_active=false WHERE id=$1',[f.users.OWNER.id]);assert.equal((await request('search',{})).status,401);});
test('catalogue managers cannot list orders, read addresses, history, or mutate',async()=>{const a=await fixtureOrder(f),manager=await f.headers('CATALOGUE_MANAGER');for(const[path,body]of [['search',{}],[a.id,undefined],[a.id,{action:'note'}]] as const){const r=await request(path,body,manager);assert.equal(r.status,403);assert.ok(!JSON.stringify(r.body).includes('Checkout Fixture'));}});
test('OWNER can read operational order details',async()=>{const a=await fixtureOrder(f);assert.equal((await read(a.id)).paymentStatus,'PAID');});
test('ADMIN can read and manage fulfillment',async()=>{headers=await f.headers('ADMIN');const a=await fixtureOrder(f);assert.equal((await operation(a.id,'prepare')).status,200);});
test('browser role and staff identity claims are rejected',async()=>{const a=await fixtureOrder(f),o=await read(a.id);assert.equal((await request(a.id,{action:'prepare',revision:o.revision,operationId:randomUUID(),role:'OWNER',actorId:f.users.OWNER.id})).status,400);assert.equal((await request('search',{},await f.headers('CATALOGUE_MANAGER'),{'x-role':'OWNER'})).status,403);});
test('all order filters are validated and applied using parameterized queries',async()=>{const a=await fixtureOrder(f),o=await read(a.id);const r=await request('search',{reference:o.reference,paymentStatus:'PAID',fulfillmentStatus:'UNARRANGED',method:'PRIVATE_DELIVERY',from:new Date().toISOString().slice(0,10),to:new Date().toISOString().slice(0,10)});assert.equal(r.body.items.length,1);assert.equal((await request('search',{reference:"' OR true --"})).body.items.length,0);for(const q of [{paymentStatus:'BOGUS'},{method:'COURIER'},{from:'2026-02-30'},{from:'2026-10-28',to:'2026-10-27'},{email:'ignored?'}])assert.equal((await request('search',q)).status,400);});
test('pagination is bounded and sorting is stable for equal creation timestamps',async()=>{const a=await fixtureOrder(f),b=await fixtureOrder(f);await f.data.query('UPDATE orders SET created_at=$1',[new Date(Date.now()-1000)]);const first=await request('search',{page:1,pageSize:1}),second=await request('search',{page:2,pageSize:1});assert.equal(first.body.hasMore,true);assert.equal(second.body.hasMore,false);assert.deepEqual([first.body.items[0].id,second.body.items[0].id],[a.id,b.id].sort().reverse());for(const q of [{page:0},{page:'1'},{page:1001},{pageSize:51}])assert.equal((await request('search',q)).status,400);});
test('purchase names, SKU, prices, totals and destination use immutable snapshots',async()=>{const a=await fixtureOrder(f),before=await read(a.id);await f.data.query("UPDATE products SET name='Changed catalogue name' WHERE id=$1",[developmentId(102)]);await f.data.query("UPDATE product_variants SET sku='NEW-SKU' WHERE id=$1",[developmentId(202)]);await f.data.query('UPDATE product_prices SET amount_minor=amount_minor+100 WHERE variant_id=$1',[developmentId(202)]);const after=await read(a.id);assert.deepEqual(after.items,before.items);assert.equal(after.amountMinor,before.amountMinor);assert.equal(after.destination,before.destination);});
test('list responses omit addresses, email, phone, guest hashes and payment secrets',async()=>{await fixtureOrder(f);const r=await request('search',{});assert.match(r.headers.get('cache-control')!??'',/private.*no-store/);for(const row of r.body.items)assert.deepEqual(Object.keys(row).sort(),['id','reference','createdAt','customerName','amountMinor','paymentStatus','method','fulfillmentStatus','exception'].sort());});
test('database privileges forbid payment writes and raw provider/secret reads',async()=>{for(const[table,column]of [['payments','status'],['orders','payment_status'],['orders','total_minor'],['orders','reconciliation_required'],['fulfillment_events','notes'],['audit_events','metadata']])assert.equal((await f.data.query('SELECT has_column_privilege($1,$2,$3,$4) AS allowed',[f.role,table,column,'UPDATE'])).rows[0].allowed,false);for(const column of ['checkout_client_secret'])assert.equal((await f.data.query('SELECT has_column_privilege($1,$2,$3,$4) AS allowed',[f.role,'payments',column,'SELECT'])).rows[0].allowed,false);assert.equal((await f.data.query('SELECT has_column_privilege($1,$2,$3,$4) AS allowed',[f.role,'payment_events','verified_payload','SELECT'])).rows[0].allowed,false);});
for(const status of ['PAID','REFUNDED'])test('manual '+status+' override is rejected without changing financial truth',async()=>{const a=await fixtureOrder(f),before=await financial(a.id),o=await read(a.id);assert.equal((await request(a.id,{action:'note',revision:o.revision,operationId:randomUUID(),notes:'Observation',paymentStatus:status})).status,400);assert.equal((await request(a.id,{action:status,revision:o.revision,operationId:randomUUID()})).status,400);assert.deepEqual(await financial(a.id),before);});
test('unpaid orders cannot begin or complete fulfillment',async()=>{const a=await fixtureOrder(f,'PRIVATE_DELIVERY',false);assert.equal((await operation(a.id,'prepare')).status,409);assert.equal((await handover(a.id)).status,409);assert.equal((await read(a.id)).arrangements.length,0);});
test('private delivery progresses only through staff-controlled stages',async()=>{const a=await fixtureOrder(f);for(const[action,stage]of [['prepare','PREPARING'],['contact','ARRANGING']] as const){assert.equal((await operation(a.id,action)).status,200);assert.equal((await read(a.id)).fulfillmentStatus,stage);}assert.equal((await operation(a.id,'propose',schedule())).status,200);assert.equal((await read(a.id)).fulfillmentStatus,'ARRANGING');assert.equal((await operation(a.id,'confirm',{confirmed:true,assignedAdminId:f.users.OWNER.id})).status,200);assert.equal((await operation(a.id,'dispatch')).status,200);assert.equal((await read(a.id)).fulfillmentStatus,'IN_PROGRESS');});
test('boutique collection progresses through preparation, agreed scheduling and readiness',async()=>{const a=await progressed('BOUTIQUE_COLLECTION');assert.equal((await read(a.id)).fulfillmentStatus,'READY');assert.equal((await operation(a.id,'dispatch')).status,409);});
test('invalid stage and fulfillment method transitions are rejected',async()=>{const a=await fixtureOrder(f);for(const action of ['dispatch','ready','contact'])assert.equal((await operation(a.id,action)).status,409);assert.equal((await handover(a.id)).status,409);});
test('appointments require a valid proposal, agreement and enabled operational staff',async()=>{const a=await fixtureOrder(f);await operation(a.id,'prepare');await operation(a.id,'contact');assert.equal((await operation(a.id,'confirm',{confirmed:true,assignedAdminId:f.users.OWNER.id})).status,409);assert.equal((await operation(a.id,'propose',{...schedule(),end:'invalid'})).status,400);await operation(a.id,'propose',schedule());assert.equal((await operation(a.id,'confirm',{confirmed:false,assignedAdminId:f.users.OWNER.id})).status,400);assert.equal((await operation(a.id,'confirm',{confirmed:true,assignedAdminId:f.users.CATALOGUE_MANAGER.id})).status,400);});
test('rescheduling retains confirmed historic dates and creates an unconfirmed successor',async()=>{const a=await arranged(),old=(await read(a.id)).arrangements[0];assert.equal((await operation(a.id,'reschedule',{...schedule(),reason:'CUSTOMER_RESCHEDULE'})).status,200);const o=await read(a.id);assert.equal(o.arrangements.length,2);assert.equal(o.arrangements[0].status,'RESCHEDULED');assert.equal(o.arrangements[0].start,old.start);assert.equal(o.arrangements[1].supersedesId,old.id);assert.equal(o.arrangements[1].status,'REQUESTED');assert.equal(o.fulfillmentStatus,'ARRANGING');});
test('concurrent edits serialize and one stale revision conflicts',async()=>{const a=await fixtureOrder(f),o=await read(a.id);const results=await Promise.all([request(a.id,{action:'prepare',revision:o.revision,operationId:randomUUID()}),request(a.id,{action:'prepare',revision:o.revision,operationId:randomUUID()})]);assert.deepEqual(results.map(r=>r.status).sort(),[200,409]);assert.equal((await read(a.id)).events.length,1);});
test('repeated identical submissions create one durable event and audit entry',async()=>{const a=await fixtureOrder(f),o=await read(a.id),body={action:'prepare',revision:o.revision,operationId:randomUUID()};const results=await Promise.all([request(a.id,body),request(a.id,body)]);assert.deepEqual(results.map(r=>r.status),[200,200]);assert.equal((await read(a.id)).audit.length,1);assert.equal((await read(a.id)).events.length,1);assert.equal((await request(a.id,{...body,notes:'Changed payload'})).status,409);});
test('delivery handover records order, arrangement, actor, recipient and actual time atomically',async()=>{const a=await progressed();assert.equal((await handover(a.id)).status,200);const o=await read(a.id),e=o.events.find(e=>e.type==='HANDOVER_COMPLETED');assert.ok(e);assert.equal(e.recipient,'Synthetic recipient');assert.equal(e.actorName,'Fixture OWNER');assert.equal(e.arrangementId,o.arrangements[0].id);assert.equal(o.fulfillmentStatus,'COMPLETED');assert.equal(o.orderStatus,'COMPLETED');assert.ok(o.arrangements[0].completedAt);});
test('boutique handover records a confirmed collection',async()=>{const a=await progressed('BOUTIQUE_COLLECTION');assert.equal((await handover(a.id)).status,200);assert.equal((await read(a.id)).fulfillmentStatus,'COMPLETED');});
test('completion requires authenticated staff and explicit recipient confirmation',async()=>{const a=await progressed(),o=await read(a.id);const body={action:'complete',revision:o.revision,operationId:randomUUID(),occurredAt:attempt(),recipient:'Fixture recipient',confirmed:true};assert.equal((await request(a.id,body,new Headers())).status,401);assert.equal((await request(a.id,{...body,confirmed:false})).status,400);assert.equal((await request(a.id,{...body,recipient:''})).status,400);});
test('a fresh completion submission cannot complete an order twice',async()=>{const a=await progressed();assert.equal((await handover(a.id)).status,200);assert.equal((await handover(a.id)).status,409);assert.equal((await read(a.id)).events.filter(e=>e.type==='HANDOVER_COMPLETED').length,1);});
test('completed historical recipient and dates are immutable; corrections append records',async()=>{const a=await progressed();await handover(a.id);const before=await read(a.id),e=before.events.find(e=>e.type==='HANDOVER_COMPLETED')!;assert.equal((await operation(a.id,'correct',{correctsEventId:e.id,notes:'Corrective operational observation'})).status,200);const after=await read(a.id);assert.deepEqual(after.events.find(x=>x.id===e.id),e);assert.deepEqual(after.arrangements,before.arrangements);assert.equal(after.events.at(-1)?.correctsEventId,e.id);assert.equal((await operation(a.id,'reschedule',{...schedule(),reason:'STAFF_RESCHEDULE'})).status,409);});
test('unsuccessful delivery records actual time, reason, staff and follow-up without releasing stock',async()=>{const a=await progressed(),before=await financial(a.id);assert.equal((await operation(a.id,'failed',{occurredAt:attempt(),reason:'CUSTOMER_UNAVAILABLE',followUp:'CONTACT_CUSTOMER',notes:'Fixture customer unavailable'})).status,200);const o=await read(a.id);assert.equal(o.fulfillmentStatus,'ARRANGING');assert.equal(o.events.find(e=>e.type==='ATTEMPT_FAILED')?.followUp,'CONTACT_CUSTOMER');assert.deepEqual(await financial(a.id),before);});
test('missed collection retains the appointment and requires a follow-up',async()=>{const a=await progressed('BOUTIQUE_COLLECTION');assert.equal((await operation(a.id,'failed',{occurredAt:attempt(),reason:'COLLECTION_MISSED',followUp:'RESCHEDULE'})).status,200);const o=await read(a.id);assert.equal(o.arrangements[0].status,'RESCHEDULED');assert.equal(o.events.find(e=>e.type==='ATTEMPT_FAILED')?.reason,'COLLECTION_MISSED');});
test('Phase 09 reconciliation exceptions remain visible and block fulfillment',async()=>{const a=await fixtureOrder(f);await f.data.query("UPDATE orders SET reconciliation_required=true,reconciliation_reason='LATE_SUCCESS' WHERE id=$1",[a.id]);const o=await read(a.id);assert.equal(o.exception,true);assert.equal(o.reconciliationReason,'LATE_SUCCESS');assert.equal(o.eligible,false);assert.equal((await operation(a.id,'prepare')).status,409);assert.equal((await request('search',{})).body.items[0].exception,true);});
test('exception acknowledgment is an internal observation with responsible staff',async()=>{const a=await fixtureOrder(f);await f.data.query("UPDATE orders SET reconciliation_required=true,reconciliation_reason='PROVIDER_STATUS_REVIEW' WHERE id=$1",[a.id]);assert.equal((await operation(a.id,'acknowledge',{notes:'Fixture review assigned to operations'})).status,200);const o=await read(a.id);assert.equal(o.events.at(-1)?.type,'EXCEPTION_ACKNOWLEDGED');assert.equal(o.events.at(-1)?.actorName,'Fixture OWNER');});
test('acknowledging an exception does not change any financial or inventory record',async()=>{const a=await fixtureOrder(f);await f.data.query("UPDATE orders SET reconciliation_required=true,reconciliation_reason='INVENTORY_MISMATCH' WHERE id=$1",[a.id]);const before=await financial(a.id);await operation(a.id,'acknowledge',{notes:'Review observation'});assert.deepEqual(await financial(a.id),before);assert.equal((await read(a.id)).exception,true);});
test('audit events contain references and stage changes without personal notes or recipient names',async()=>{const a=await progressed();await handover(a.id);const o=await read(a.id);assert.equal(o.audit.length,6);assert.ok(o.audit.some(a=>a.action==='ORDER_HANDOVER_COMPLETED'));const audit=JSON.stringify(o.audit);assert.ok(!audit.includes('Synthetic recipient'));assert.ok(!audit.includes('Fixture handover observation'));});
test('an audit insertion failure rolls back arrangement, event, revision and stage',async()=>{const a=await fixtureOrder(f),before=await read(a.id);await f.data.query(`REVOKE INSERT ON audit_events FROM "${f.role}"`);try{assert.equal((await operation(a.id,'prepare')).status,503);}finally{await f.data.query(`GRANT INSERT ON audit_events TO "${f.role}"`);}const after=await read(a.id);assert.equal(after.revision,before.revision);assert.equal(after.arrangements.length,0);assert.equal(after.events.length,0);assert.equal(after.fulfillmentStatus,'UNARRANGED');});
test('foreign-key conflict codes return 409 with full rollback; unrelated errors remain 503',async()=>{
  const a=await fixtureOrder(f),before=await read(a.id);
  // Inject backend errors at the final audit write, after operational writes.
  await f.data.query(`CREATE FUNCTION public.compatibility_conflict_fixture() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN RAISE EXCEPTION 'Synthetic database rejection' USING ERRCODE = TG_ARGV[0]; END $$`);
  try{
    for(const[code,status]of [['23503',409],['23001',409],['XX000',503]] as const){
      await f.data.query(`CREATE TRIGGER compatibility_conflict_fixture BEFORE INSERT ON audit_events
        FOR EACH ROW EXECUTE FUNCTION public.compatibility_conflict_fixture('${code}')`);
      try{assert.equal((await operation(a.id,'prepare')).status,status);assert.deepEqual(await read(a.id),before);}
      finally{await f.data.query('DROP TRIGGER compatibility_conflict_fixture ON audit_events');}
    }
  }finally{await f.data.query('DROP FUNCTION public.compatibility_conflict_fixture()');}
});
test('customer order status remains private to the owning guest session',async()=>{const a=await fixtureOrder(f),b=await fixtureOrder(f);assert.equal((await a.customer()).status,200);assert.equal((await a.customer(b.session)).status,404);assert.equal((await a.customer('')).status,404);});
test('customer projection exposes fulfillment stage without staff, observations or diagnostics',async()=>{const a=await progressed();await operation(a.id,'note',{notes:'PRIVATE operational observation'});const c=await a.customer();assert.equal(c.body.order.fulfillmentStatus,'IN_PROGRESS');const serialized=JSON.stringify(c.body);for(const secret of ['PRIVATE operational observation','Fixture OWNER','Fixture ADMIN','actorAdmin','audit','reconciliationReason'])assert.ok(!serialized.includes(secret));});
test('every fulfillment operation leaves purchased inventory and payment amounts unchanged',async()=>{const a=await fixtureOrder(f),before=await financial(a.id);await operation(a.id,'prepare');await operation(a.id,'contact');await operation(a.id,'propose',schedule());await operation(a.id,'confirm',{confirmed:true,assignedAdminId:f.users.ADMIN.id});await operation(a.id,'dispatch');await handover(a.id);assert.deepEqual(await financial(a.id),before);});
test('fulfillment operations perform no external provider or other network calls',async()=>{const a=await fixtureOrder(f),original=globalThis.fetch;let calls=0;globalThis.fetch=async()=>{calls++;throw new Error('Unexpected network call');};try{assert.equal((await operation(a.id,'prepare')).status,200);assert.equal(calls,0);}finally{globalThis.fetch=original;}});
test('detail and error DTOs exclude authentication/payment credentials and raw callback data',async()=>{const a=await fixtureOrder(f),response=await request(a.id),serialized=JSON.stringify(response.body);for(const value of [f.password,f.authConfig.secret,f.authConfig.databaseUrl,'checkout_client_secret','verified_payload','source_data','signature','guest_session_hash'])assert.ok(!serialized.includes(value));assert.match(response.headers.get('cache-control')!??'',/no-store/);const bad=await request('not-a-uuid');assert.equal(bad.status,400);assert.ok(!JSON.stringify(bad.body).includes('SELECT'));});
test('inactive or changed boutique configuration preserves the original destination',async()=>{const a=await arranged('BOUTIQUE_COLLECTION'),before=await read(a.id);await f.data.query("UPDATE boutique_locations SET name='Changed boutique',street_address='Changed street',is_active=false WHERE id=$1",[a.locationId]);const after=await read(a.id);assert.equal(after.destination,before.destination);assert.equal(after.locationChanged,true);assert.equal(after.locationActive,false);assert.equal((await operation(a.id,'ready')).status,409);assert.equal((await operation(a.id,'failed',{occurredAt:attempt(),reason:'LOCATION_UNAVAILABLE',followUp:'LOCATION_REVIEW'})).status,200);});
test('CSRF, unsupported fields, excessive notes, invalid timestamps and query parameters fail safely',async()=>{const a=await fixtureOrder(f);assert.equal((await request('search',{},headers,{Origin:'https://untrusted.test'})).status,403);assert.equal((await request('search',{},headers,{'Sec-Fetch-Site':'cross-site'})).status,403);assert.equal((await operation(a.id,'note',{notes:'x'.repeat(1001)})).status,400);assert.equal((await request('search',{reference:'x'.repeat(9000)})).status,413);assert.equal((await request(a.id+'?email=fixture',undefined)).status,400);assert.equal((await operation(a.id,'complete',{confirmed:true,recipient:'Fixture recipient',occurredAt:'2026-02-30T10:00:00.000Z'})).status,400);});
