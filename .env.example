# Server only. Copy to .env.local; replace placeholders with your local role/database.
# Tooling accepts loopback lapalme_dev_* / lapalme_test_* databases only.
DATABASE_URL=postgresql://YOUR_LOCAL_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
# Hosted setup is deferred. Non-loopback connections always verify TLS certificates.
# Never use NEXT_PUBLIC_DATABASE_URL or commit .env.local.

# Admin authentication is optional for public pages. Use a separate restricted
# write role for this same database, never the migration-owner credential.
ADMIN_DATABASE_URL=postgresql://YOUR_ADMIN_RUNTIME_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
# Exact application origin. Production requires HTTPS; no path or wildcard.
BETTER_AUTH_URL=https://YOUR_CONFIRMED_HOST
# Generate a unique 32-byte random base64url secret; placeholders are rejected.
BETTER_AUTH_SECRET=YOUR_RANDOM_SECRET
# Optional ONLY behind an edge that overwrites this header and isolates origin.
# Otherwise leave unset: shared source throttling still protects all instances.
# ADMIN_TRUSTED_IP_HEADER=cf-connecting-ip
