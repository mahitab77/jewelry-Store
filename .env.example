# Server only. Copy to .env.local; replace placeholders with your local role/database.
# Tooling accepts loopback lapalme_dev_* / lapalme_test_* databases only.
DATABASE_URL=postgresql://YOUR_LOCAL_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
# Hosted setup is deferred. Non-loopback connections always verify TLS certificates.
# Never use NEXT_PUBLIC_DATABASE_URL or commit .env.local.

# Public canonical origin. Configure the same confirmed HTTPS origin before build
# and at runtime. Leave indexing disabled on local/staging deployments.
# SITE_URL=https://YOUR_CONFIRMED_HOST
SITE_INDEXING_ALLOWED=false

# Admin authentication is optional for public pages. Use a separate restricted
# write role for this same database, never the migration-owner credential.
ADMIN_DATABASE_URL=postgresql://YOUR_ADMIN_RUNTIME_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
# Exact application origin. Production requires HTTPS; no path or wildcard.
BETTER_AUTH_URL=https://YOUR_CONFIRMED_HOST
# Generate a unique 32-byte random base64url secret; placeholders are rejected.
BETTER_AUTH_SECRET=YOUR_RANDOM_SECRET
# Optional ONLY behind an edge that overwrites this header and isolates origin.
# Otherwise leave unset: shared source throttling still protects all instances.
# ADMIN_TRUSTED_IP_HEADER=cf-connecting-ip

# Server-only Cloudinary Free product photography. No live uploads in tests.
# Authenticated assets are delivered through publication-gated app image routes.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Separate restricted guest-cart role; never fall back to admin/owner credentials.
CART_DATABASE_URL=postgresql://YOUR_CART_RUNTIME_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
# Exact public origin, without a trailing slash. HTTPS is required in production.
CART_ORIGIN=https://YOUR_CONFIRMED_HOST

# Keep false in production until checkout:purge is scheduled at least hourly.
# Draft saving fails closed without this explicit retention acknowledgement.
CHECKOUT_DRAFT_RETENTION_READY=false

# Phase 09: TEST ONLY. Never set live credentials; live mode is rejected.
# Use a separate restricted payment role in the SAME application database.
PAYMENT_DATABASE_URL=postgresql://YOUR_PAYMENT_RUNTIME_ROLE:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/lapalme_dev_catalogue
PAYMENTS_TEST_ENABLED=false
# Acknowledge only after scheduling/monitoring payments:reconcile and manual exceptions.
PAYMENTS_RECONCILIATION_READY=false
PAYMOB_MODE=test
PAYMOB_SECRET_KEY=YOUR_PAYMOB_TEST_SECRET_KEY
PAYMOB_PUBLIC_KEY=YOUR_PAYMOB_TEST_PUBLIC_KEY
PAYMOB_HMAC_SECRET=YOUR_PAYMOB_HMAC_SECRET
# The shared API key is used ONLY for authenticated read-only transaction inquiries.
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=YOUR_TEST_INTEGRATION_ID
# Signed callback obj.owner (account user ID), not unsigned profile_id.
PAYMOB_OWNER_ID=YOUR_PAYMOB_OWNER_ID

# Server-only commerce policy. Missing/unknown values default to quotation-only.
# DIRECT_SALES requires a separately reviewed commercial/security operation.
COMMERCE_MODE=QUOTATION_ONLY

# Operator-only encrypted backups. Never expose these settings to browser code.
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
# BACKUP_DATABASE_URL=postgresql://YOUR_BACKUP_ROLE:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=verify-full
# BACKUP_ENCRYPTION_KEY=YOUR_SEPARATELY_STORED_32_BYTE_BASE64URL_KEY
# RESTORE_DATABASE_URL=postgresql://YOUR_LOCAL_ROLE@127.0.0.1:5432/lapalme_test_restore_unique_suffix
# Background media cleanup uses a narrowly granted operator role (see readiness doc).
# MEDIA_CLEANUP_DATABASE_URL=postgresql://YOUR_MEDIA_CLEANUP_ROLE:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=verify-full
