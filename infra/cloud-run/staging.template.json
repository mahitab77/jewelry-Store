{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "REPLACE_SERVICE",
    "namespace": "REPLACE_PROJECT_NUMBER",
    "labels": { "app": "lapalme", "environment": "staging", "cloud.googleapis.com/location": "REPLACE_REGION" },
    "annotations": {
      "run.googleapis.com/ingress": "all",
      "run.googleapis.com/invoker-iam-disabled": "false",
      "run.googleapis.com/minScale": "0",
      "run.googleapis.com/maxScale": "2"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "run.googleapis.com/cpu-throttling": "true",
          "run.googleapis.com/startup-cpu-boost": "false"
        }
      },
      "spec": {
        "serviceAccountName": "REPLACE_RUNTIME_SERVICE_ACCOUNT",
        "containerConcurrency": 4,
        "timeoutSeconds": 60,
        "containers": [{
          "image": "REPLACE_AMD64_IMAGE_DIGEST",
          "ports": [{ "containerPort": 8080 }],
          "resources": { "limits": { "cpu": "1", "memory": "1Gi" } },
          "env": [
            { "name": "SITE_INDEXING_ALLOWED", "value": "false" },
            { "name": "CHECKOUT_DRAFT_RETENTION_READY", "value": "false" },
            { "name": "PAYMENTS_TEST_ENABLED", "value": "false" },
            { "name": "PAYMENTS_RECONCILIATION_READY", "value": "false" },
            { "name": "PAYMOB_MODE", "value": "test" },
            { "name": "ADMIN_TRUSTED_IP_HEADER", "value": "" }
          ],
          "startupProbe": {
            "httpGet": { "path": "/robots.txt", "port": 8080 },
            "timeoutSeconds": 3, "periodSeconds": 3, "failureThreshold": 40
          },
          "livenessProbe": {
            "httpGet": { "path": "/robots.txt", "port": 8080 },
            "timeoutSeconds": 3, "periodSeconds": 30, "failureThreshold": 3
          }
        }]
      }
    },
    "traffic": [{ "latestRevision": true, "percent": 100 }]
  }
}
